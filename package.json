{
  "name": "@iwonz/yeelight-controller",
  "version": "2.0.0",
  "description": "Library for using Yeelight WiFi Light Inter-Operation Specification",
  "keywords": [
    "yeelight bulbs wifi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iwonz/yeelight-controller.git"
  },
  "author": "iwonz <iwonz@yandex.ru>",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "files": [
    "dist/",
    "CHANGELOG.md"
  ],
  "types": "dist/typings/index.d.ts",
  "bugs": {
    "url": "https://github.com/iwonz/yeelight-controller/issues"
  },
  "homepage": "https://github.com/iwonz/yeelight-controller#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && npm run tsc",
    "tsc": "tsc -p tsconfig.json && tsc -p tsconfig-cjs.json",
    "prepublishOnly": "npm run check",
    "prepare": "husky",
    "test": "npm run build && npm run test:types && node --test tests",
    "test:types": "tsc -p tsconfig.tests.json",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "check": "npm run test && npm run lint && npm run knip"
  },
  "lint-staged": {
    "*.{js,ts,json}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "knip": "^6.44.2",
    "lint-staged": "^17.6.0",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2"
  }
}
